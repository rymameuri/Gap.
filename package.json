{
  "name": "gap-learning-workspace",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "node dev-server.mjs",
    "dev:api": "tsx watch apps/backend/src/index.ts",
    "dev:web": "vite --config apps/frontend/vite.config.ts",
    "build": "npm run typecheck && vite build --config apps/frontend/vite.config.ts && tsc -p apps/backend/tsconfig.json",
    "typecheck": "tsc --noEmit -p apps/frontend/tsconfig.json && tsc --noEmit -p apps/backend/tsconfig.json",
    "start": "node apps/backend/build/index.js",
    "test": "node --import tsx --test \"apps/backend/src/**/*.test.ts\" \"apps/backend/tools/**/*.test.ts\"",
    "test:coverage": "node --import tsx --test --experimental-test-coverage --test-coverage-include=\"apps/backend/src/**\" --test-coverage-include=\"apps/backend/tools/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"apps/backend/src/agents/**\" --test-coverage-lines=95 --test-coverage-branches=90 --test-coverage-functions=95 \"apps/backend/src/**/*.test.ts\" \"apps/backend/tools/**/*.test.ts\"",
    "test:student": "node --import tsx --test apps/frontend/src/pages/student/course-model.test.ts apps/frontend/src/pages/student/assistant-format.test.ts apps/frontend/src/components/speech-recognition.test.ts",
    "format": "prettier --write --end-of-line auto \"apps/**/*.{ts,tsx,css,html,md}\" \"docs/*.md\" README.md package.json dev-server.mjs",
    "typecheck:backend": "tsc --noEmit -p apps/backend/tsconfig.test.json",
    "lint:backend": "eslint apps/backend",
    "format:check:backend": "prettier --check --end-of-line auto \"apps/backend/**/*.{ts,mjs,json,md,yaml}\" eslint.config.js \".github/**/*.yml\"",
    "check:forbidden": "node --import tsx apps/backend/tools/check-forbidden.ts",
    "check:backend": "npm run typecheck:backend && npm run lint:backend && npm run format:check:backend && npm test && npm run check:forbidden",
    "db": "node --import tsx apps/backend/src/migrate-cli.ts",
    "prepare": "node apps/backend/tools/install-hooks.mjs"
  },
  "dependencies": {
    "dotenv": "^16.4.0",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "fflate": "0.8.3",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "mammoth": "^1.12.3",
    "pino": "10.3.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0",
    "sql.js": "1.14.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.25",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "^4.3.0",
    "ajv": "8.20.0",
    "eslint": "10.10.0",
    "prettier": "^3.9.8",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "8.70.0",
    "vite": "^6.1.0",
    "yaml": "2.9.1"
  }
}
