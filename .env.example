# Backend server. Validated at startup; see apps/backend/README.md.
# NODE_ENV is set by the runtime, not here: Vite also reads .env files.
API_HOST=127.0.0.1
API_PORT=3001
WEB_PORT=3000
# Extra origin allowed to send state-changing requests, e.g. https://app.example.com
APP_ORIGIN=
DATABASE_PATH=.runtime/gap.sqlite
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# Reverse proxies in front of the API (for example 1 behind one load balancer).
TRUST_PROXY=0
# Optional live AI. Without both values, the local teaching engine is used.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-4.1-mini
# These credentials are for the seeded demonstration accounts only.
DEMO_PASSWORD=GapDemo!2026

# QuantumBlack gateway (takes priority when credentials are present).
QB_CLIENT_ID=
QB_CLIENT_SECRET=
QB_GATEWAY_ENDPOINT=https://azure.prod.ai-gateway.quantumblack.com/c14bbe16-d124-4f7f-a7fd-aba42ee3865e/
QB_GATEWAY_MODEL=gpt-5.4-2026-03-05
QB_GATEWAY_API_VERSION=2024-04-01-preview
# Alternatively set AZURE_OPENAI_API_KEY or QB_GATEWAY_TOKEN.
